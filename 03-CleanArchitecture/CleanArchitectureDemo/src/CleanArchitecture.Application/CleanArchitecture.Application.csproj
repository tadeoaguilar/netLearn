<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Application depends on Domain and nothing else. No EF Core, no ASP.NET.
    The interfaces in Abstractions/ are the PORTS: this layer declares what it
    needs, and Infrastructure supplies it. That inversion is what lets these
    use cases be tested with no database at all.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CleanArchitecture.Domain/CleanArchitecture.Domain.csproj" />
  </ItemGroup>

</Project>
