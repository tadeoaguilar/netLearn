<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="9.5.2" />

  <!--
    Central package management is turned OFF for this one project, same as
    09-EnterpriseCRUD/src/TaskManagement.AppHost and every module 11 AppHost.
    The Aspire SDK injects its own package references at build time, which
    cannot be declared in Directory.Packages.props.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <UserSecretsId>cloudnative-aspire-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="9.5.2" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="9.5.2" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="9.5.2" />
    <!--
      Only needed for Part B (Azure deployment): declares the Azure Container
      Apps environment as an explicit resource so `azd`/`aspire publish` know
      where to deploy each project resource. Building/running locally does
      not require this package at all, see EXERCISE.md Part B.1.
    -->
    <PackageReference Include="Aspire.Hosting.Azure.AppContainers" Version="9.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CatalogApi/CatalogApi.Solution.csproj" IsAspireProjectResource="true" />
    <ProjectReference Include="../Storefront/Storefront.Solution.csproj" IsAspireProjectResource="true" />
  </ItemGroup>

</Project>
