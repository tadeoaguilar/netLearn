<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="9.5.2" />

  <!--
    Central package management is turned OFF for this one project. The Aspire
    SDK injects its own package references at build time, which cannot be
    declared in Directory.Packages.props.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsAspireHost>true</IsAspireHost>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <UserSecretsId>taskmanagement-apphost</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="9.5.2" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="9.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TaskManagement.WebApi/TaskManagement.WebApi.csproj"
                      IsAspireProjectResource="true" />
  </ItemGroup>

</Project>
