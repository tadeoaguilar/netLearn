<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>CosmosIndexingAndThroughput.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.Azure.Cosmos" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AppHost/CosmosIndexingAndThroughput.AppHost.csproj" />
    <!--
      A ProjectReference to AppHost alone does not transitively expose solution/'s
      public types here (its reference to solution/ is marked IsAspireProjectResource,
      which Aspire uses to generate the Projects.* type rather than as a normal
      compile-time dependency chain). Tests that assert against Models/Indexing/etc.
      need this direct reference too.
    -->
    <ProjectReference Include="../solution/CosmosIndexingAndThroughput.Solution.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
