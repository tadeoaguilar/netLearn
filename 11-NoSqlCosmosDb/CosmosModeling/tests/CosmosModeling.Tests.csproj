<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>CosmosModeling.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Aspire.Hosting.Testing" />
    <PackageReference Include="Microsoft.Azure.Cosmos" />
    <!-- Microsoft.Azure.Cosmos requires this to be referenced explicitly. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AppHost/CosmosModeling.AppHost.csproj" />
    <!-- Direct reference (not just transitive via AppHost) so Domain types (Customer,
         Order, OrderLine, HighVolumeOrder) and CosmosInitializer are available to tests. -->
    <ProjectReference Include="../solution/CosmosModeling.Solution.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
  </ItemGroup>

</Project>
