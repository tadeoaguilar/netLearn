{
  "IsEncrypted": false,
  "Values": {
    "AzureWebJobsStorage": "UseDevelopmentStorage=true",
    "FUNCTIONS_WORKER_RUNTIME": "dotnet-isolated",
    "EntraId__TenantId": "<your-tenant-id>",
    "EntraId__Audience": "api://<api-app-registration-client-id>",
    "EntraId__RequiredAppRole": "Notes.Access",
    "KeyVault__VaultUri": "https://<your-key-vault-name>.vault.azure.net/",
    "KeyVault__SecretName": "demo-secret"
  }
}
